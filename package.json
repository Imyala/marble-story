{
  "name": "marble-story",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marble Story - a 2D side-scrolling MMORPG-style action RPG built in the spirit of MapleStory",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
