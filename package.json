{
  "name": "wyrmling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wyrmling: First Flight - a 3D elemental dragon action-adventure for the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/finish-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "smoke": "node scripts/smoke-run.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
